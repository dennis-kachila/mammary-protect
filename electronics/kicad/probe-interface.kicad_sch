(text "The GM100 probe has two separate coaxial leads, corresponding to transmit and receive." (at 145 35 0) (effects (font (size 1.27 1.27))) (uuid "5cd802c8-de09-555b-8a44-b21b23e2471d"))
(text "Lead A/B physical TX/RX identity is unknown from the supplied product photo." (at 145 45 0) (effects (font (size 1.27 1.27))) (uuid "34f2b463-2a6a-5eb7-9d67-46bdd43b00e2"))
(text "Identify the leads using marked gauge sockets or a verified probe datasheet before connection." (at 145 55 0) (effects (font (size 1.27 1.27))) (uuid "a1c4b887-8e2a-58d6-9ed3-b8e4a8ce6c7d"))
(text "This is an interface map only: no pulser, receiver protection, isolation or connector footprint." (at 145 150 0) (effects (font (size 1.27 1.27))) (uuid "f34b2f25-85e5-5b51-a6a9-269215c3f3fb"))
(text "Do not energize the probe from this drawing; bench characterization and electrical review are needed." (at 145 160 0) (effects (font (size 1.27 1.27))) (uuid "54719e97-c884-5500-b179-20ca98baa36e"))
)
